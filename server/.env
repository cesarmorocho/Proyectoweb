# === CONFIGURACIÓN DE SECRETO JWT ===
# JWT_SECRET es la clave secreta utilizada para firmar y verificar los JSON Web Tokens (JWT)
# Esta clave debe ser:
# - Única y secreta para cada aplicación
# - Suficientemente compleja (se recomienda al menos 32 caracteres)
# - NUNCA compartida públicamente o subida a repositorios públicos
# 
# Funciones principales:
# 1. FIRMA de tokens: Se usa para crear la firma digital del JWT al hacer login
# 2. VERIFICACIÓN de tokens: Se usa para validar que un token no ha sido alterado
# 3. SEGURIDAD: Garantiza que solo el servidor que conoce esta clave puede crear/validar tokens
#
# IMPORTANTE: Esta clave actual "12345678" es MUY INSEGURA para producción
# Se recomienda cambiar por una clave más robusta como:
# JWT_SECRET = "mi_clave_super_secreta_y_compleja_de_al_menos_32_caracteres_2024"
JWT_SECRET = "12345678"
